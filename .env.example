# ==============================================================================
# RESTAURANT LEAD FINDER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# All secrets must remain server-side. Never commit real credentials.

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Authentication & Database
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# CRITICAL: Service role key is only used in server-side operations and background jobs.
# NEVER expose this key to browser bundles or client-side components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Places API / Google Maps Platform
# Enabled APIs required: Places API (New) or Places API Web Service
# Docs: https://developers.google.com/maps/documentation/places/web-service/overview
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Search & Background Worker Safeguards
DEFAULT_DAILY_REQUEST_BUDGET=500
DEFAULT_MAX_RECORDS_PER_JOB=1000
SCAN_WORKER_CONCURRENCY=2

# Website Verification Configuration
WEBSITE_VERIFY_TIMEOUT_MS=8000
WEBSITE_VERIFY_MAX_REDIRECTS=3
